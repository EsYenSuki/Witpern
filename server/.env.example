# Copy this file to .env and edit it. Never commit .env.

PORT=8787
HOST=0.0.0.0
DATA_DIR=./data

# Login for viewing the data pages (GET /, /data, /data/*).
# POST /collect stays open and does NOT need these credentials.
COLLECT_USER=admin
COLLECT_PASS=change-me

# Public tunnel URL (trailing slash is fine)
CLOUDFLARE_URL=https://your-name.trycloudflare.com/
